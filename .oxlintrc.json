{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "vitest", "node"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    ".impeccable",
    "apps/playground/.local"
  ]
}
