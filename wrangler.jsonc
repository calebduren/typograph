{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typograph",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "routes": [
    { "pattern": "typograph.dev", "custom_domain": true },
    { "pattern": "typograph.ing", "custom_domain": true },
    { "pattern": "www.typograph.dev", "custom_domain": true },
    { "pattern": "www.typograph.ing", "custom_domain": true },
  ],
  "assets": {
    "directory": "./apps/playground/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
}
