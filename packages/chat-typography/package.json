{
  "name": "@calebduren/typograph",
  "version": "0.1.0",
  "description": "Conservative typography for streamed Markdown chat responses",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/hanging.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hanging": {
      "types": "./dist/hanging.d.ts",
      "import": "./dist/hanging.js"
    },
    "./hanging.css": "./dist/hanging.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/hanging.ts --format esm --dts --minify --clean && cp src/hanging.css dist/hanging.css"
  },
  "dependencies": {
    "@typehug/en": "0.2.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4"
  },
  "homepage": "https://typograph.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebduren/typograph.git",
    "directory": "packages/chat-typography"
  },
  "bugs": {
    "url": "https://github.com/calebduren/typograph/issues"
  },
  "keywords": [
    "typography",
    "remark",
    "markdown",
    "streaming",
    "ai",
    "punctuation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
