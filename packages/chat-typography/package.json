{
  "name": "@calebduren/typograph",
  "version": "0.4.1",
  "description": "Conservative English typography for AI-generated text: streamed chat, finished Markdown, and plain strings",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/hanging.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hanging": {
      "types": "./dist/hanging.d.ts",
      "import": "./dist/hanging.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    },
    "./hanging.css": "./dist/hanging.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/hanging.ts src/static.ts --format esm --dts --minify --clean && cp src/hanging.css dist/hanging.css"
  },
  "dependencies": {
    "@typehug/en": "0.2.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4"
  },
  "peerDependencies": {
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "peerDependenciesMeta": {
    "rehype-parse": {
      "optional": true
    },
    "rehype-stringify": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    },
    "remark-parse": {
      "optional": true
    },
    "remark-rehype": {
      "optional": true
    },
    "unified": {
      "optional": true
    }
  },
  "homepage": "https://typograph.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebduren/typograph.git",
    "directory": "packages/chat-typography"
  },
  "bugs": {
    "url": "https://github.com/calebduren/typograph/issues"
  },
  "keywords": [
    "typography",
    "remark",
    "markdown",
    "streaming",
    "ai",
    "punctuation",
    "llm",
    "chat",
    "static",
    "email"
  ],
  "publishConfig": {
    "access": "public"
  }
}
